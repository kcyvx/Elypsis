{
  "author": "Thomas Galabert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcyvx/Elypsis"
  },
  "name": "elypsis-cli",
  "version": "0.2.1",
  "description": "Add ready-to-use login and register pages, with working auth, to a Next.js project in one command.",
  "type": "module",
  "bin": {
    "elypsis": "./dist/index.js",
    "elypsis-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nextjs",
    "auth",
    "better-auth",
    "cli",
    "scaffold",
    "login",
    "register"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}